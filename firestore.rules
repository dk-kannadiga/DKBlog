rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isOwnQuizSubmission(submissionId) {
      return signedIn()
        && submissionId.matches('^.+_' + request.auth.uid + '$');
    }

    function validLibraryRequest() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'bookId', 'bookTitle', 'userId', 'name', 'contact', 'message', 'status', 'requestedAt'
        ])
        && request.resource.data.bookId is string
        && request.resource.data.bookId.size() >= 1
        && request.resource.data.bookId.size() <= 64
        && request.resource.data.bookTitle is string
        && request.resource.data.bookTitle.size() >= 1
        && request.resource.data.bookTitle.size() <= 160
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() >= 3
        && request.resource.data.contact.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedAt == request.time
        && exists(/databases/$(database)/documents/libraryBooks/$(request.resource.data.bookId))
        && get(/databases/$(database)/documents/libraryBooks/$(request.resource.data.bookId)).data.title == request.resource.data.bookTitle
        && get(/databases/$(database)/documents/libraryBooks/$(request.resource.data.bookId)).data.lendingPolicy == 'lendable'
        && get(/databases/$(database)/documents/libraryBooks/$(request.resource.data.bookId)).data.status == 'available';
    }

    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /libraryBooks/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /libraryRequests/{requestId} {
      // The request document may not exist yet when a visitor opens a book.
      // Authorize that lookup from the deterministic document id instead of
      // reading resource.data, which is unavailable for a missing document.
      allow get: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if validLibraryRequest();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['returned', 'rejected']
        && validLibraryRequest()
      );
      allow delete: if isAdmin() && resource.data.status == 'rejected';
    }

    match /libraryRequestPointers/{pointerId} {
      allow get: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (
        signedIn()
        && request.resource.data.keys().hasOnly(['bookId', 'userId', 'activeRequestId', 'status', 'updatedAt'])
        && request.resource.data.bookId is string
        && request.resource.data.userId == request.auth.uid
        && pointerId == request.resource.data.bookId + '_' + request.auth.uid
        && request.resource.data.activeRequestId is string
        && request.resource.data.status == 'requested'
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if false;
    }

    match /siteSettings/{setting} {
      allow read: if true;
      allow create, update: if isAdmin() && (
        setting != 'activeQuiz' || request.resource.data.quiz == null || request.resource.data.quiz.securityVersion == 2
      );
      allow delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.state == 'archived';
      allow delete: if isAdmin();
    }

    match /quizKeys/{quizId} {
      allow read, write: if isAdmin();
    }

    match /quizReceipts/{receiptId} {
      allow get: if isAdmin() || isOwnQuizSubmission(receiptId);
      allow list, write: if false;
    }

    match /quizSubmissions/{submissionId} {
      allow get: if isAdmin() || isOwnQuizSubmission(submissionId);
      allow list: if isAdmin();
      // Only the trusted grading service (owner OAuth/IAM) may create results.
      // Even owner-browser edits cannot rewrite recorded scores.
      allow create, update, delete: if false;
    }

    match /prizeQuizEntries/{entryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'name', 'txt', 'date', 'userId', 'createdAt'])
        && request.resource.data.postId is int
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.txt is string
        && request.resource.data.txt.size() >= 1
        && request.resource.data.txt.size() <= 2000
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 32
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'txt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.txt is string
        && request.resource.data.txt.size() >= 1
        && request.resource.data.txt.size() <= 2000;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'userId', 'createdAt'])
        && request.resource.data.postId is int
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
