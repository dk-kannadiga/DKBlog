{
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "DK's Writings",
        "supportEmail": "support@dkblog-6c5e5.firebaseapp.com"
      }
    }
  },
  "hosting": {
    "predeploy": [
      "node scripts/generate-rss-sitemap.mjs"
    ],
    "public": ".",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "rss.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/rss+xml; charset=utf-8"
          }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "backup/**",
      "integrations/**",
      "scripts/**",
      "outputs/**",
      "README.md",
      "New Text Document.txt",
      "firestore.rules",
      "comment-test.html",
      "firebase-test.html",
      "firestore-adapter-test.html",
      "firestore-posts.html"
    ],
    "rewrites": [
      {
        "source": "/{index,collections,library,about,quiz,admin}",
        "destination": "/index.html"
      },
      {
        "source": "/{post,quiz,collection}/*",
        "destination": "/index.html"
      },
      {
        "source": "/library/book/*",
        "destination": "/index.html"
      }
    ]
  }
}
